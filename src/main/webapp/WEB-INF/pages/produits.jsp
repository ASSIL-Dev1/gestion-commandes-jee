<%@ page import="ma.fstt.web.ProduitPage" %><% if(new ProduitPage().handle(request,response)) return; %>
<%@ include file="/WEB-INF/jspf/header.jspf" %>
<c:choose><c:when test="${form}"><p class="subtitle">${empty param.id ? 'Ajouter' : 'Modifier'} un produit.</p>
<section class="panel form-panel"><form method="post" action="${pageContext.request.contextPath}/produits"><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="<c:out value="${param.id}"/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}">
<div class="form-grid"><label>Référence<input name="reference" type="text" value="<c:out value="${pageContext.request.method eq 'POST' ? param.reference : item.reference}"/>" maxlength="40" required></label>
<label>Désignation<input name="designation" type="text" value="<c:out value="${pageContext.request.method eq 'POST' ? param.designation : item.designation}"/>" maxlength="180" required></label>
<label>Prix unitaire (MAD)<input name="prix" type="number" value="<c:out value="${pageContext.request.method eq 'POST' ? param.prix : item.prix}"/>" min="0" max="99999999.99" step="0.01" required></label>
</div><div class="form-actions"><button class="button" type="submit">Enregistrer</button><a class="button secondary" href="${pageContext.request.contextPath}/produits">Annuler</a></div></form></section>
</c:when><c:otherwise><div class="page-heading"><p class="subtitle">Organisez votre catalogue et vos prix de vente.</p><a class="button" href="${pageContext.request.contextPath}/produits?action=new">+ Nouveau produit</a></div>
<section class="panel"><div class="panel-heading"><h2>Liste des produits</h2><input class="search" type="search" data-table-search placeholder="Rechercher…" aria-label="Rechercher dans la liste"></div>
<div class="table-wrap"><table data-searchable><thead><tr><th>N°</th><th>Référence</th><th>Désignation</th><th>Prix unitaire (MAD)</th><th>Actions</th></tr></thead><tbody>
<c:forEach items="${items}" var="e"><tr><td class="muted">#<c:out value="${e.id}"/></td><td><c:out value="${e.reference}"/></td><td><c:out value="${e.designation}"/></td><td><fmt:formatNumber value="${e.prix}" minFractionDigits="2"/> MAD</td><td><div class="row-actions"><a href="${pageContext.request.contextPath}/produits?action=edit&amp;id=${e.id}">Modifier</a><form method="post" action="${pageContext.request.contextPath}/produits" data-confirm="Supprimer cet enregistrement ?"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${e.id}"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button type="submit" class="danger-link">Supprimer</button></form></div></td></tr></c:forEach>
<c:if test="${empty items}"><tr><td colspan="5" class="empty">Aucun produit enregistré.</td></tr></c:if></tbody></table><p class="search-empty" hidden>Aucun résultat pour cette recherche.</p></div></section></c:otherwise></c:choose>
<%@ include file="/WEB-INF/jspf/footer.jspf" %>
