<%@ page import="ma.fstt.web.CommandePage" %><% if(new CommandePage().handle(request,response)) return; %>
<%@ include file="/WEB-INF/jspf/header.jspf" %>
<c:set var="root" value="${pageContext.request.contextPath}"/>
<c:choose><c:when test="${form}">
<p class="subtitle">${empty param.id ? 'Créer une commande' : 'Modifier la commande'} · prix enregistrés en MAD.</p>
<c:if test="${empty clients or empty produits}"><div class="notice error">Pour créer une commande, ajoutez au moins un <a href="${root}/clients?action=new">client</a> et un <a href="${root}/produits?action=new">produit</a>.</div></c:if>
<section class="panel form-panel"><form method="post" action="${root}/commandes" data-order-form>
<input type="hidden" name="action" value="save"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="<c:out value="${param.id}"/>">
<div class="form-grid three"><label>Client<select name="clientId" required><option value="">Choisir un client</option><c:forEach items="${clients}" var="cl"><option value="${cl.id}" ${(pageContext.request.method eq 'POST' ? param.clientId : item.client.id) eq cl.id ? 'selected' : ''}><c:out value="${cl.nom}"/></option></c:forEach></select></label>
<label>Date de commande<input type="date" name="dateCommande" required min="1900-01-01" max="2100-12-31" value="<c:out value="${pageContext.request.method eq 'POST' ? param.dateCommande : (empty item ? today : item.dateCommande)}"/>"></label>
<label>Statut<select name="statut"><c:forEach items="${['EN_COURS','VALIDEE','LIVREE','ANNULEE']}" var="status"><option value="${status}" ${(pageContext.request.method eq 'POST' ? param.statut : (empty item ? 'EN_COURS' : item.statut)) eq status ? 'selected' : ''}><c:out value="${status}"/></option></c:forEach></select></label></div>
<div class="panel-heading line-heading"><div><h2>Lignes de commande</h2><p>Un produit par ligne. Les prix existants sont conservés lors d'une modification.</p></div><button type="button" class="button secondary" data-add-line>+ Ajouter une ligne</button></div>
<div class="table-wrap"><table class="order-lines"><thead><tr><th>Produit</th><th>Quantité</th><th>Prix (MAD)</th><th>Sous-total (MAD)</th><th></th></tr></thead><tbody data-lines>
<c:set var="lines" value="${pageContext.request.method eq 'POST' ? submittedLines : item.lignes}"/>
<c:forEach items="${lines}" var="line"><tr data-line data-original-product="${line.produit.id}" data-original-price="${line.prixUnitaire}"><td><select name="produitId" required data-product><option value="">Choisir un produit</option><c:forEach items="${produits}" var="p"><option value="${p.id}" data-price="${p.prix}" ${line.produit.id eq p.id ? 'selected' : ''}><c:out value="${p.reference}"/> · <c:out value="${p.designation}"/></option></c:forEach></select></td><td><input aria-label="Quantité" type="number" name="quantite" min="1" max="100000" step="1" value="${line.quantite}" required data-quantity></td><td data-price-display></td><td data-subtotal></td><td><button type="button" class="danger-link" data-remove-line aria-label="Retirer la ligne">Retirer</button></td></tr></c:forEach>
</tbody></table></div>
<template id="line-template"><tr data-line><td><select name="produitId" required data-product><option value="">Choisir un produit</option><c:forEach items="${produits}" var="p"><option value="${p.id}" data-price="${p.prix}"><c:out value="${p.reference}"/> · <c:out value="${p.designation}"/></option></c:forEach></select></td><td><input aria-label="Quantité" type="number" name="quantite" min="1" max="100000" step="1" value="1" required data-quantity></td><td data-price-display></td><td data-subtotal></td><td><button type="button" class="danger-link" data-remove-line>Retirer</button></td></tr></template>
<div class="order-total">Total estimé <strong><span data-order-total>0,00</span> MAD</strong></div><div class="form-actions"><button class="button" type="submit" ${empty clients or empty produits ? 'disabled' : ''}>Enregistrer la commande</button><a href="${root}/commandes" class="button secondary">Annuler</a></div></form></section>
</c:when><c:when test="${detail and not empty item}"><div class="page-heading"><p class="subtitle">Commande CMD-<c:out value="${item.id}"/> · <c:out value="${item.client.nom}"/> · <c:out value="${item.dateCommande}"/></p><div class="row-actions"><a class="button secondary" href="${root}/commandes">Retour</a><a class="button" href="${root}/commandes?action=edit&amp;id=${item.id}">Modifier</a></div></div>
<section class="panel"><div class="panel-heading"><h2>Détail de la commande</h2><span class="badge ${item.statut}"><c:out value="${item.statut}"/></span></div><div class="table-wrap"><table><thead><tr><th>Référence</th><th>Produit</th><th>Quantité</th><th class="number">Prix unitaire</th><th class="number">Sous-total</th></tr></thead><tbody><c:forEach items="${item.lignes}" var="l"><tr><td><c:out value="${l.produit.reference}"/></td><td><c:out value="${l.produit.designation}"/></td><td><c:out value="${l.quantite}"/></td><td class="number"><fmt:formatNumber value="${l.prixUnitaire}" minFractionDigits="2"/> MAD</td><td class="number"><fmt:formatNumber value="${l.sousTotal}" minFractionDigits="2"/> MAD</td></tr></c:forEach></tbody></table></div><div class="order-total">Total de la commande <strong><fmt:formatNumber value="${item.total}" minFractionDigits="2"/> MAD</strong></div></section>
</c:when><c:otherwise><div class="page-heading"><p class="subtitle">Créez, consultez et suivez les commandes de vos clients.</p><a class="button" href="${root}/commandes?action=new">+ Nouvelle commande</a></div>
<section class="panel"><div class="panel-heading"><h2>Toutes les commandes</h2><input class="search" type="search" data-table-search placeholder="Rechercher…" aria-label="Rechercher une commande"></div><div class="table-wrap"><table data-searchable><thead><tr><th>N°</th><th>Client</th><th>Date</th><th>Statut</th><th class="number">Total</th><th>Actions</th></tr></thead><tbody><c:forEach items="${items}" var="o"><tr><td class="strong">CMD-<c:out value="${o.id}"/></td><td><c:out value="${o.client.nom}"/></td><td><c:out value="${o.dateCommande}"/></td><td><span class="badge ${o.statut}"><c:out value="${o.statut}"/></span></td><td class="number"><fmt:formatNumber value="${o.total}" minFractionDigits="2"/> MAD</td><td><div class="row-actions"><a href="${root}/commandes?action=detail&amp;id=${o.id}">Voir</a><a href="${root}/commandes?action=edit&amp;id=${o.id}">Modifier</a><form method="post" action="${root}/commandes" data-confirm="Supprimer cette commande et toutes ses lignes ?"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${o.id}"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button class="danger-link" type="submit">Supprimer</button></form></div></td></tr></c:forEach><c:if test="${empty items}"><tr><td colspan="6" class="empty">Aucune commande enregistrée.</td></tr></c:if></tbody></table><p class="search-empty" hidden>Aucun résultat pour cette recherche.</p></div></section></c:otherwise></c:choose>
<%@ include file="/WEB-INF/jspf/footer.jspf" %>
